{
  "$schema": "./node_modules/release-it/schema/release-it.json",

  "git": {
    "requireBranch": "main",
    "commitMessage": "chore(release): v${version}",
    "tagName": "v${version}",
    "tagAnnotation": "Steam Bridge v${version}"
  },

  "npm": {
    "publish": false
  },

  "github": {
    "release": true,
    "host": "github.com"
  }
}
